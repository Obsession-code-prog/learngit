{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "构建并运行 robot_demo",
      "type": "shell",
      "command": "${workspaceFolder}/run.sh",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "仅构建",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "build", "-j"],
      "problemMatcher": ["$gcc"]
    }
  ]
}
