{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "调试 robot_demo",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/robot_demo",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "仅构建",
      "setupCommands": [
        {
          "description": "启用 gdb 整齐打印",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
